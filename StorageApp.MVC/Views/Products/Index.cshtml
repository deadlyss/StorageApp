@model IEnumerable<StorageApp.DAL.Models.Product>

<div class="container mt-4">

    <h2>Products list</h2>

    <table class="table table-striped table-hover">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
            </tr>
        }
        </tbody>

    </table>

</div>